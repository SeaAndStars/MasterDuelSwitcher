<ui:FluentWindow x:Class="MasterDuelSwitcher.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Master Duel Switcher" Width="1100" Height="760" MinWidth="900" MinHeight="620"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True" ResizeMode="CanResize"
                 FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" Background="{DynamicResource ApplicationBackgroundBrush}"
                 Closing="OnWindowClosing"
                 AutomationProperties.AutomationId="MainWindow">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Fluent 标题栏：保留标准最小化、缩放和关闭操作。 -->
        <ui:TitleBar Title="Master Duel Switcher" ForceShutdown="False" ShowMaximize="True"
                     Background="{DynamicResource ApplicationBackgroundBrush}">
            <ui:TitleBar.Icon><ui:SymbolIcon Symbol="Games24" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" /></ui:TitleBar.Icon>
        </ui:TitleBar>
        <!-- 操作期间统一禁用内容，保留标题栏与忙碌反馈。 -->
        <Grid x:Name="Workspace" Grid.Row="1" IsEnabled="{Binding IsReady}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0" Padding="14,20,14,18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="12,0,0,28">
                        <Border Background="{DynamicResource SystemAccentColorPrimaryBrush}" Width="46" Height="46" CornerRadius="12" HorizontalAlignment="Left">
                            <TextBlock Text="MD" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" FontFamily="Segoe UI Semibold" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="MASTER DUEL" FontFamily="Segoe UI Semibold" FontWeight="SemiBold" FontSize="14" Margin="0,13,0,4" />
                        <TextBlock Text="账号与资源管理" Style="{StaticResource MutedStyle}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <ui:Button x:Name="AccountsNav" Style="{StaticResource NavStyle}" Tag="{Binding IsAccountsPage}" Command="{Binding NavigateCommand}" CommandParameter="Accounts" AutomationProperties.AutomationId="NavAccounts">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Person24" Margin="0,0,12,0" /><TextBlock Text="账号切换" /></StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="ResourcesNav" Style="{StaticResource NavStyle}" Tag="{Binding IsResourcesPage}" Command="{Binding NavigateCommand}" CommandParameter="Resources" AutomationProperties.AutomationId="NavResources">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Folder24" Margin="0,0,12,0" /><TextBlock Text="资源共享" /></StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="BackupsNav" Style="{StaticResource NavStyle}" Tag="{Binding IsBackupsPage}" Command="{Binding NavigateCommand}" CommandParameter="Backups" AutomationProperties.AutomationId="NavBackups">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="History24" Margin="0,0,12,0" /><TextBlock Text="备份还原" /></StackPanel>
                        </ui:Button>
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="10,18,10,12" />
                        <ui:Button x:Name="SettingsNav" Style="{StaticResource NavStyle}" Tag="{Binding IsSettingsPage}" Command="{Binding NavigateCommand}" CommandParameter="Settings" AutomationProperties.AutomationId="NavSettings">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" /><TextBlock Text="设置" /></StackPanel>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="12,12,0,0">
                        <TextBlock x:Name="DiscoveryStatus" Text="{Binding DiscoveryStatus}" FontSize="11" Style="{StaticResource MutedStyle}" />
                        <TextBlock x:Name="AdminStatus" Text="{Binding AdminStatus}" FontSize="10" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" AutomationProperties.AutomationId="AdminStatus" />
                        <TextBlock Text="Steam Windows 版" FontSize="10" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="28,22,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="STEAM  /  MASTER DUEL" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="1,0,0,8" />
                        <TextBlock x:Name="PageTitle" Text="{Binding Title}" Style="{StaticResource HeadingStyle}" />
                        <TextBlock x:Name="PageSubtitle" Text="{Binding Subtitle}" Style="{StaticResource MutedStyle}" Margin="0,7,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="刷新" Icon="{ui:SymbolIcon ArrowClockwise24}" VerticalAlignment="Center"
                               Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="Refresh" Padding="13,8" />
                </Grid>
                <!-- 账号页：真实账号列表和可编辑的本地账号信息。 -->
                <Grid x:Name="AccountsPage" Grid.Row="1" Visibility="{Binding IsAccountsPage, Converter={StaticResource BoolVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="260" /><ColumnDefinition Width="20" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock x:Name="AccountCount" Text="{Binding AccountCountText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <CheckBox x:Name="ShowHiddenToggle" Content="显示隐藏" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11"
                                      IsChecked="{Binding ShowHidden, Mode=TwoWay}" AutomationProperties.AutomationId="ShowHidden" />
                        </DockPanel>
                        <ListBox x:Name="AccountList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource AccountItemStyle}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="AccountList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,4,0,8" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontSize="10" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="AccountsEmpty" Grid.Row="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top" Visibility="{Binding NoAccounts, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="PersonAdd24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" FontSize="26" Margin="0,0,0,16" />
                                <TextBlock Text="还没有可显示的账号" Style="{StaticResource SectionStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="在 Steam 正常登录并记住账号，然后点击刷新。路径未检测到时，请先打开设置。" Style="{StaticResource MutedStyle}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        <ui:Button Grid.Row="2" Content="添加账号的方式" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddAccountCommand}" Margin="0,10,0,0"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.AutomationId="AddAccount" />
                    </Grid>
                    <Grid Grid.Column="2">
                        <Border Style="{StaticResource CardStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="账号信息" Style="{StaticResource SectionStyle}" />
                                    <StackPanel x:Name="SelectedAccountPanel" Visibility="{Binding HasSelectedAccount, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock x:Name="SelectedAccountTitle" Text="{Binding SelectedAccount.Account.DisplayName}" FontSize="21" FontWeight="SemiBold" Margin="0,20,0,6" TextWrapping="Wrap" />
                                        <TextBlock x:Name="SelectedAccountId" Text="{Binding SelectedAccount.SteamIdLabel}" Style="{StaticResource PathStyle}" />
                                        <TextBlock x:Name="SelectedAccountState" Text="{Binding SelectedAccount.LoginState}" Style="{StaticResource MutedStyle}" Margin="0,10,0,24" />
                                        <TextBlock Text="本地备注" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <ui:TextBox x:Name="AccountNote" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.AutomationId="AccountNote" />
                                        <TextBlock Text="绑定本账号的资源目录" FontWeight="SemiBold" Margin="0,19,0,8" />
                                        <ComboBox x:Name="AccountBinding" DisplayMemberPath="DisplayName" ItemsSource="{Binding BindingOptions}" SelectedItem="{Binding SelectedBinding, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="AccountBinding" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="先在游戏中确认账号对应的 LocalData 目录，再手工绑定。" Style="{StaticResource MutedStyle}" FontSize="11" Margin="0,7,0,18" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ui:Button Content="保存账号信息" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveAccountCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="SaveAccount" />
                                            <ui:Button x:Name="HideAccountButton" Grid.Column="1" Content="{Binding SelectedAccount.HideLabel}" Appearance="Transparent" Command="{Binding HideAccountCommand}" AutomationProperties.AutomationId="HideAccount" />
                                        </Grid>
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="12" Margin="0,22,0,16">
                                            <TextBlock Text="已配置共享来源时，切换会先关联本账号的资源目录。Steam 会自行提示首次登录或会话验证。" TextWrapping="Wrap" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontSize="11" LineHeight="20" />
                                        </Border>
                                        <ui:Button Content="切换并启动" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Command="{Binding SwitchAndLaunchCommand}"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,12" AutomationProperties.AutomationId="SwitchAndLaunch" />
                                    </StackPanel>
                                    <StackPanel x:Name="SelectAccountHint" Margin="0,44,0,0">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasSelectedAccount}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                        <ui:SymbolIcon Symbol="Cursor24" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" HorizontalAlignment="Left" FontSize="30" Margin="0,0,0,18" />
                                        <TextBlock Text="从左侧选择一个账号" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="备注和资源绑定保存在本机。切换前请先退出 Master Duel。" Style="{StaticResource MutedStyle}" Margin="0,12,0,0" />
                                        <TextBlock Text="首次使用" FontWeight="SemiBold" Margin="0,30,0,8" />
                                        <TextBlock Text="1  检查 Steam 与游戏路径&#x0a;2  在资源共享页选择已更新的来源&#x0a;3  为账号绑定资源目录后启动" Style="{StaticResource MutedStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
                <!-- 资源页：独立资源来源、实际目录和共享状态。 -->
                <ScrollViewer x:Name="ResourcesPage" Grid.Row="1" Visibility="{Binding IsResourcesPage, Converter={StaticResource BoolVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="共享资源来源" Style="{StaticResource SectionStyle}" />
                                <TextBlock Text="选择已完成游戏更新的独立目录，其他账号将共用其中的 0000 资源。" Style="{StaticResource MutedStyle}" Margin="0,8,0,16" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="SourceProfile" DisplayMemberPath="DisplayName" ItemsSource="{Binding SourceProfiles}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="SourceProfile" HorizontalAlignment="Stretch" />
                                    <ui:Button Grid.Column="1" Content="保存来源" Command="{Binding SaveSourceCommand}" Margin="12,0,0,0" AutomationProperties.AutomationId="SaveSource" />
                                </Grid>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ResourceSummary" Text="{Binding ResourceSummary}" Style="{StaticResource MutedStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ui:Button Grid.Column="1" Content="为其他目录启用共享" Appearance="Primary" Command="{Binding EnableSharingCommand}" AutomationProperties.AutomationId="EnableSharing" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="本机资源目录" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ItemsControl x:Name="ProfileList" ItemsSource="{Binding Profiles}" AutomationProperties.AutomationId="ProfileList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="Folder24" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ResourcePath}" Style="{StaticResource PathStyle}" Margin="0,7,0,0" />
                                                <TextBlock Text="{Binding LinkTarget, StringFormat='共享到：{0}'}" Margin="0,3,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PathStyle}">
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsLinked}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="ResourcesEmpty" Style="{StaticResource CardStyle}" Visibility="{Binding NoProfiles, Converter={StaticResource BoolVisibility}}">
                            <StackPanel><TextBlock Text="先让游戏下载资源" Style="{StaticResource SectionStyle}" /><TextBlock Text="通过 Steam 启动 Master Duel 并完成一次更新，再刷新此页。也可在设置中检查游戏安装目录。" Style="{StaticResource MutedStyle}" Margin="0,10,0,0" /></StackPanel>
                        </Border>
                        <TextBlock Text="共享只关联 0000 下载资源；原有目录先保留备份。账号存档由游戏与 Steam 管理。" Style="{StaticResource MutedStyle}" FontSize="11" Margin="0,10,0,4" />
                    </StackPanel>
                </ScrollViewer>
                <!-- 备份页：资源事务还原和 Steam 最近登录配置还原分开操作。 -->
                <ScrollViewer x:Name="BackupsPage" Grid.Row="1" Visibility="{Binding IsBackupsPage, Converter={StaticResource BoolVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="资源共享备份" Style="{StaticResource SectionStyle}" />
                                <TextBlock Text="选择一次操作，恢复当时保留的独立资源目录。请先退出游戏。" Style="{StaticResource MutedStyle}" Margin="0,8,0,15" />
                                <ListBox x:Name="BackupList" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup, Mode=TwoWay}" DisplayMemberPath="DisplayName" MinHeight="120" MaxHeight="270" AutomationProperties.AutomationId="BackupList" />
                                <TextBlock x:Name="BackupsEmpty" Text="还没有共享操作记录。启用共享后，备份会显示在这里。" Style="{StaticResource MutedStyle}" Margin="0,12,0,0" Visibility="{Binding NoBackups, Converter={StaticResource BoolVisibility}}" />
                                <ui:Button Content="还原选中备份" Command="{Binding RestoreResourcesCommand}" Icon="{ui:SymbolIcon ArrowUndo24}" HorizontalAlignment="Left" Margin="0,16,0,0" AutomationProperties.AutomationId="RestoreResources" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Steam 登录配置" Style="{StaticResource SectionStyle}" />
                                <TextBlock Text="恢复工具上次切号前保存的最近账号设置。Steam 会先正常退出。" Style="{StaticResource MutedStyle}" Margin="0,8,0,16" />
                                <ui:Button Content="还原上次 Steam 登录配置" Command="{Binding RestoreSteamCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="RestoreSteam" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- 设置页：自动发现路径，也支持用户手动选择安装目录。 -->
                <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="安装路径" Style="{StaticResource SectionStyle}" />
                                <TextBlock Text="选择包含 Steam.exe 的 Steam 目录和包含 masterduel.exe 的游戏目录。" Style="{StaticResource MutedStyle}" Margin="0,8,0,18" />
                                <TextBlock Text="Steam 目录" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="SteamPathBox" Text="{Binding SteamPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.AutomationId="SteamPath" />
                                    <ui:Button Grid.Column="1" Content="浏览" Command="{Binding BrowseFolderCommand}" CommandParameter="Steam" Margin="10,0,0,0" AutomationProperties.AutomationId="BrowseSteam" />
                                </Grid>
                                <TextBlock Text="Master Duel 目录" FontWeight="SemiBold" Margin="0,20,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="GamePathBox" Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.AutomationId="GamePath" />
                                    <ui:Button Grid.Column="1" Content="浏览" Command="{Binding BrowseFolderCommand}" CommandParameter="Game" Margin="10,0,0,0" AutomationProperties.AutomationId="BrowseGame" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                    <ui:Button Content="保存并检测" Appearance="Primary" Command="{Binding SaveSettingsCommand}" AutomationProperties.AutomationId="SaveSettings" />
                                    <ui:Button Content="重新自动检测" Command="{Binding AutoDetectCommand}" Margin="10,0,0,0" AutomationProperties.AutomationId="AutoDetect" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="外观" Style="{StaticResource SectionStyle}" /><TextBlock Text="主题偏好自动保存在本机。" Style="{StaticResource MutedStyle}" Margin="0,6,0,0" /></StackPanel>
                                <ui:ToggleSwitch x:Name="DarkThemeToggle" Grid.Column="1" Content="深色主题" VerticalAlignment="Center" IsChecked="{Binding DarkTheme, Mode=TwoWay}" Command="{Binding ToggleThemeCommand}" AutomationProperties.AutomationId="DarkTheme" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="本地工具数据" Style="{StaticResource SectionStyle}" />
                                <TextBlock x:Name="StateDirectoryText" Text="{Binding StateDirectory}" Style="{StaticResource PathStyle}" Margin="0,10,0,0" />
                                <TextBlock Text="账号信息保存在系统数据目录。移动或删除 EXE 后，备注、绑定和隐藏状态仍保留。" Style="{StaticResource MutedStyle}" FontSize="11" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- 底部状态始终可见；展开后查看有数量上限的操作记录。 -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource MutedStyle}" FontSize="11" MaxHeight="44" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="StatusText" />
                        <Expander Header="操作记录" IsExpanded="False" FontSize="11" Margin="0,4,0,0">
                            <ListBox x:Name="StatusLog" ItemsSource="{Binding Logs}" MaxHeight="95" FontSize="11" BorderThickness="0" Background="Transparent" Margin="0,7,0,0" AutomationProperties.AutomationId="StatusLog" />
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <!-- 异步操作遮罩，避免重复提交资源和 Steam 操作。 -->
        <Border x:Name="BusyOverlay" Grid.Row="1" Background="{DynamicResource SmokeFillColorDefaultBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}">
            <Border Style="{StaticResource CardStyle}" Width="340" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <TextBlock x:Name="BusyText" Text="{Binding BusyMessage}" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <TextBlock Text="请保持窗口打开，完成后会自动刷新。" Style="{StaticResource MutedStyle}" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>


