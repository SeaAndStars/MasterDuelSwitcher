<ui:FluentWindow x:Class="MasterDuelSwitcher.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:MasterDuelSwitcher.App.Views.Pages"
                 Title="Master Duel Switcher" Width="1100" Height="760" MinWidth="900" MinHeight="620"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True" ResizeMode="CanResize"
                 FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" FontSize="14"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" Background="{DynamicResource ApplicationBackgroundBrush}"
                 Closing="OnWindowClosing" Loaded="OnWindowLoaded"
                 AutomationProperties.AutomationId="MainWindow">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 官方 Fluent 标题栏保留标准窗口操作。 -->
        <ui:TitleBar Title="Master Duel Switcher" ForceShutdown="False" ShowMaximize="True"
                     Background="{DynamicResource ApplicationBackgroundBrush}">
            <ui:TitleBar.Icon><ui:SymbolIcon Symbol="Games24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></ui:TitleBar.Icon>
        </ui:TitleBar>
        <!-- 工作区包含官方导航和实际独立 Page，由同一个忙碌状态约束交互。 -->
        <Grid x:Name="Workspace" Grid.Row="1" IsEnabled="{Binding Workspace.IsReady}">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ui:NavigationView x:Name="MainNavigation" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="182"
                               ClipToBounds="True"
                               IsPaneToggleVisible="False" IsBackButtonVisible="Collapsed" IsTopSeparatorVisible="False"
                               FrameMargin="0" Padding="28,0,28,0" SelectionChanged="OnNavigationSelectionChanged"
                               Background="{DynamicResource ApplicationBackgroundBrush}" AutomationProperties.AutomationId="MainNavigation">
                <ui:NavigationView.PaneHeader>
                    <StackPanel Margin="20,20,12,28">
                        <Border x:Name="BrandLogo" Background="{DynamicResource AccentButtonBackground}" Width="46" Height="46" CornerRadius="12" HorizontalAlignment="Left">
                            <TextBlock Text="MD" Foreground="{DynamicResource AccentButtonForeground}" FontWeight="SemiBold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="MASTER DUEL" FontWeight="SemiBold" FontSize="14" Margin="0,13,0,4" />
                        <TextBlock Text="账号与资源管理" Style="{StaticResource MutedStyle}" FontSize="11" />
                    </StackPanel>
                </ui:NavigationView.PaneHeader>
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem x:Name="AccountsNav" Content="账号切换" Icon="{ui:SymbolIcon Person24}" TargetPageTag="Accounts"
                                           TargetPageType="{x:Type pages:AccountsPage}" AutomationProperties.AutomationId="NavAccounts" />
                    <ui:NavigationViewItem x:Name="ResourcesNav" Content="资源共享" Icon="{ui:SymbolIcon Folder24}" TargetPageTag="Resources"
                                           TargetPageType="{x:Type pages:ResourcesPage}" AutomationProperties.AutomationId="NavResources" />
                    <ui:NavigationViewItem x:Name="BackupsNav" Content="备份还原" Icon="{ui:SymbolIcon History24}" TargetPageTag="Backups"
                                           TargetPageType="{x:Type pages:BackupsPage}" AutomationProperties.AutomationId="NavBackups" />
                    <ui:NavigationViewItem x:Name="FreePacksNav" Content="免费开包" Icon="{ui:SymbolIcon Games24}" TargetPageTag="FreePacks"
                                           TargetPageType="{x:Type pages:FreePacksPage}" AutomationProperties.AutomationId="NavFreePacks" />
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem x:Name="SettingsNav" Content="设置" Icon="{ui:SymbolIcon Settings24}" TargetPageTag="Settings"
                                           TargetPageType="{x:Type pages:SettingsPage}" AutomationProperties.AutomationId="NavSettings" />
                </ui:NavigationView.FooterMenuItems>
                <ui:NavigationView.PaneFooter>
                    <StackPanel x:Name="NavigationStatusFooter" Margin="20,12,12,18" AutomationProperties.AutomationId="NavigationStatusFooter">
                        <TextBlock x:Name="DiscoveryStatus" Text="{Binding Workspace.DiscoveryStatus}" FontSize="11" Style="{StaticResource MutedStyle}" />
                        <TextBlock x:Name="AdminStatus" Text="{Binding AdminStatus}" FontSize="10" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" AutomationProperties.AutomationId="AdminStatus" />
                        <TextBlock Text="Steam Windows 版" FontSize="10" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:NavigationView.PaneFooter>
                <!-- 页面标题属于 Shell，页面本身由官方 NavigationViewContentPresenter 显示。 -->
                <ui:NavigationView.Header>
                    <Grid Margin="28,22,28,22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="STEAM  /  MASTER DUEL" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="1,0,0,8" />
                            <TextBlock x:Name="PageTitle" Text="{Binding Title}" Style="{StaticResource HeadingStyle}" />
                            <TextBlock x:Name="PageSubtitle" Text="{Binding Subtitle}" Style="{StaticResource MutedStyle}" Margin="0,7,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="刷新" Icon="{ui:SymbolIcon ArrowClockwise24}" VerticalAlignment="Center"
                                   Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="Refresh" Padding="13,8" />
                    </Grid>
                </ui:NavigationView.Header>
            </ui:NavigationView>
            <!-- 固定状态区占独立布局行，页面和滚动内容始终在它上方。 -->
            <Border Grid.Row="1" Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="218,0,28,18" Padding="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="{Binding Workspace.Status}" Style="{StaticResource MutedStyle}" FontSize="11" MaxHeight="44" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="StatusText" />
                    <ui:CardExpander Header="操作记录" IsExpanded="False" FontSize="14" Margin="0,4,0,0">
                        <ListBox x:Name="StatusLog" ItemsSource="{Binding Workspace.Logs}" MaxHeight="95" FontSize="11" BorderThickness="0" Background="Transparent" Margin="0,7,0,0" AutomationProperties.AutomationId="StatusLog" />
                    </ui:CardExpander>
                </StackPanel>
            </Border>
        </Grid>
        <!-- 异步操作遮罩覆盖全部页面，防止重复提交。 -->
        <Border x:Name="BusyOverlay" Grid.Row="1" Background="{DynamicResource SmokeFillColorDefaultBrush}" Visibility="{Binding Workspace.IsBusy, Converter={StaticResource BoolVisibility}}">
            <Border Style="{StaticResource CardStyle}" Width="340" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource ProgressBarForeground}" />
                    <TextBlock x:Name="BusyText" Text="{Binding Workspace.BusyMessage}" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <TextBlock Text="请保持窗口打开，完成后会自动刷新。" Style="{StaticResource MutedStyle}" FontSize="11" HorizontalAlignment="Center" />
                    <StackPanel Visibility="{Binding FreePacks.IsRunning, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0">
                        <TextBlock x:Name="FreePacksOverlayStage" Text="{Binding FreePacks.Stage}" TextWrapping="Wrap" HorizontalAlignment="Center"
                                   AutomationProperties.AutomationId="FreePacksOverlayStage" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,16">
                            <TextBlock Text="已扫描 " /><TextBlock x:Name="FreePacksOverlayScannedCount" Text="{Binding FreePacks.ScannedPacks}" />
                            <TextBlock Text="  ·  已开包 " /><TextBlock x:Name="FreePacksOverlayOpenedCount" Text="{Binding FreePacks.OpenedPacks}" />
                        </StackPanel>
                        <ui:Button x:Name="FreePacksOverlayStop" Content="停止免费开包" Command="{Binding FreePacks.StopCommand}"
                                   HorizontalAlignment="Center" AutomationProperties.AutomationId="FreePacksOverlayStop">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Stop24" /></ui:Button.Icon>
                        </ui:Button>
                        <TextBlock Text="也可以在游戏中按 F8 停止。" Style="{StaticResource MutedStyle}" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <!-- 官方模态内容宿主在工作区外保持可交互，覆盖所有通知和可恢复错误。 -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="2" Panel.ZIndex="10" AutomationProperties.AutomationId="DialogHost" />
    </Grid>
</ui:FluentWindow>
