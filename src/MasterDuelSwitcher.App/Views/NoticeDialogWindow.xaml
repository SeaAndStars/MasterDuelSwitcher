<ui:FluentWindow x:Class="MasterDuelSwitcher.App.Views.NoticeDialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Master Duel Switcher" Width="560" Height="380" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="None" ExtendsContentIntoTitleBar="True"
                 FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" FontSize="14"
                 Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <ui:TitleBar Title="Master Duel Switcher" ForceShutdown="False" ShowMinimize="False" ShowMaximize="False" ShowClose="False" VerticalAlignment="Top" Height="48" />
        <!-- 主窗口创建之前仍以同一官方内容对话框显示启动错误。 -->
        <ui:ContentDialogHost x:Name="DialogHost" Margin="0,48,0,0" AutomationProperties.AutomationId="DialogHost" />
    </Grid>
</ui:FluentWindow>
